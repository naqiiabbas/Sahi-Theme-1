{%- doc -%}
  One item in the product features row: an icon (uploaded image used as a color mask, or a fallback file
  from the assets folder) and a short label. Settings are read from block.settings.

  @example
  {% content_for 'blocks' %}
{%- enddoc -%}

{%- liquid
  assign icon_url = ''
  if block.settings.icon_image != blank
    assign icon_url = block.settings.icon_image | image_url: width: 160
  elsif block.settings.fallback_icon != blank
    assign icon_url = block.settings.fallback_icon | asset_url
  endif
-%}

<li
  class="product-feature"
  {{ block.shopify_attributes }}
>
  {%- if icon_url != blank -%}
    <span
      class="product-feature__icon"
      style="--product-feature-icon: url('{{ icon_url }}');"
      aria-hidden="true"
    ></span>
  {%- endif -%}
  <span class="product-feature__label">{{ block.settings.label | escape | newline_to_br }}</span>
</li>

{% stylesheet %}
  .product-feature {
    display: flex;
    flex: 1 1 0;
    align-items: center;
    gap: var(--gap-xs);
    min-width: 8rem;
    padding-inline: var(--padding-md);

    &:first-child {
      padding-inline-start: 0;
    }

    & + & {
      border-inline-start: 1px solid rgb(var(--product-features-ink-rgb, var(--color-foreground-rgb)) / var(--opacity-15));
    }

    /* Narrow screens: icon above label so three items fit in one row. */
    @media screen and (max-width: 749px) {
      flex-direction: column;
      min-width: 0;
      padding-inline: var(--padding-xs);
      text-align: center;

      &:first-child {
        padding-inline-start: var(--padding-xs);
      }
    }
  }

  .product-feature__icon {
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
    background-color: currentColor;
    -webkit-mask: var(--product-feature-icon) center / contain no-repeat;
    mask: var(--product-feature-icon) center / contain no-repeat;
  }

  .product-feature__label {
    min-width: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    line-height: 1.3;
    color: rgb(var(--product-features-ink-rgb, var(--color-foreground-rgb)) / var(--opacity-85));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.feature",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "t:settings.icon",
      "info": "t:info.spotlight_icon_image"
    },
    {
      "type": "text",
      "id": "fallback_icon",
      "label": "t:settings.fallback_image",
      "info": "t:info.fallback_image"
    },
    {
      "type": "textarea",
      "id": "label",
      "label": "t:settings.label",
      "default": "Feature"
    }
  ]
}
{% endschema %}

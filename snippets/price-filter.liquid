{%- doc -%}
  Renders a price filter.

  @param {object} filter - The filter object to render.
  @param {string} filter_style - The filter style, can be 'horizontal' or 'vertical'.
  @param {boolean} [should_render_clear] - Whether to render the clear button.
  @param {string} [id_prefix] - Unique prefix to avoid duplicate IDs when rendered multiple times.
  @param {boolean} [show_slider] - Replaces the min and max fields with a two-handle slider that writes to them.

  @example
  {% render 'price-filter', filter: filter, filter_style: 'vertical', id_prefix: 'dialog', show_slider: true %}
{%- enddoc -%}

{%- liquid
  assign is_horizontal = false
  assign is_vertical = false
  if filter_style == 'horizontal'
    assign is_horizontal = true
  elsif filter_style == 'vertical'
    assign is_vertical = true
  endif

  # The slider needs a price range to span.
  assign has_slider = false
  if show_slider and filter.range_max > 0
    assign has_slider = true
    assign slider_min = filter.min_value.value | default: 0 | at_most: filter.range_max
    assign slider_max = filter.max_value.value | default: filter.range_max | at_most: filter.range_max
    assign slider_start = slider_min | times: 100.0 | divided_by: filter.range_max
    assign slider_end = slider_max | times: 100.0 | divided_by: filter.range_max
  endif
-%}
{%- if has_slider -%}
  <script
    src="{{ 'price-range-slider.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- endif -%}
{% capture accordion_children %}
  <details
    class="facets__panel"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary
      class="facets__summary"
      data-testid="price-filter"
    >
      <span class="facets__label">{{ filter.label }}</span>
      <facet-status-component class="facets__status">
        <template ref="moneyFormat">{{ shop.money_format }}</template>

        <span
          class="hide-when-empty"
          ref="facetStatus"
          data-currency="{{ localization.country.currency.iso_code }}"
          data-range-max="{{ filter.range_max | money_without_currency }}"
        >
          {%- if filter.min_value.value != null or filter.max_value.value != null %}
            {%- if filter.min_value.value != null and filter.max_value.value != null %}
              <bdi>{{ filter.min_value.value | money | strip_html }}–{{ filter.max_value.value | money | strip_html }}</bdi>
            {%- elsif filter.min_value.value != null -%}
              <bdi>{{ filter.min_value.value | money | strip_html }}–{{ filter.range_max | money | strip_html }}</bdi>

            {%- elsif filter.max_value.value != null -%}
              <bdi>{{ 0 | money | strip_html }}–{{ filter.max_value.value | money | strip_html }}</bdi>
            {%- endif -%}
          {%- endif -%}
        </span>
      </facet-status-component>
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>
    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-custom-popover{% endif %}"
    >
      {% assign min_input_max_value = filter.max_value.value | default: filter.range_max %}
      {% assign max_input_min_value = filter.min_value.value | default: 0 %}

      <price-facet-component
        class="
          price-facet
          {%- if filter_style == 'horizontal' %}
            price-facet--horizontal
          {%- endif %}
          {%- if has_slider %}
            price-facet--slider
          {%- endif %}
        "
        id="facet-inputs-{{ filter.param_name | escape | replace: '.', '-' }}"
        data-money-format="{{ shop.money_format | strip_html }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        on:change="/updatePriceFilterAndResults"
      >
        <div class="facets__inputs-wrapper facets__inputs-wrapper--row">
          <div
            class="price-facet__inputs-wrapper"
          >
            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.min_value.param_name }}"
                id="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
                {%- if filter.min_value.value -%}
                  value="{{ filter.min_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="0"
                data-min="0"
                data-max="{{ min_input_max_value | money_without_currency }}"
                ref="minInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_low' | t }}"
              >

              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>

            <div class="price-facet__separator">{{ 'fields.separator' | t }}</div>

            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.max_value.param_name }}"
                id="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
                {%- if filter.max_value.value -%}
                  value="{{ filter.max_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="{{ filter.range_max | money_without_currency }}"
                data-min="{{ max_input_min_value | money_without_currency }}"
                data-max="{{ filter.range_max | money_without_currency }}"
                ref="maxInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_high' | t }}"
              >
              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>
          </div>
        </div>

        {%- if has_slider -%}
          {% comment %}
            The range inputs have no name, so only the text fields above are submitted. The slider writes to
            them, and its bubbling change event runs this component's updatePriceFilterAndResults.
          {% endcomment %}
          <price-range-slider
            class="price-range"
            style="--price-range-start: {{ slider_start }}%; --price-range-end: {{ slider_end }}%;"
            data-range-max="{{ filter.range_max }}"
          >
            <div class="price-range__track">
              <span
                class="price-range__fill"
                aria-hidden="true"
              ></span>
              <input
                type="range"
                class="price-range__input"
                min="0"
                max="{{ filter.range_max }}"
                step="1"
                value="{{ slider_min }}"
                aria-label="{{ 'accessibility.price_filter_low' | t }}"
                aria-valuetext="{{ slider_min | money_without_trailing_zeros | strip_html }}"
                ref="minRange"
                on:input="/handleInput"
              >
              <input
                type="range"
                class="price-range__input"
                min="0"
                max="{{ filter.range_max }}"
                step="1"
                value="{{ slider_max }}"
                aria-label="{{ 'accessibility.price_filter_high' | t }}"
                aria-valuetext="{{ slider_max | money_without_trailing_zeros | strip_html }}"
                ref="maxRange"
                on:input="/handleInput"
              >
            </div>
            <p
              class="price-range__values"
              aria-hidden="true"
            >
              <bdi ref="minLabel">{{ slider_min | money_without_trailing_zeros | strip_html }}</bdi>
              <span>{{ 'fields.separator' | t }}</span>
              <bdi ref="maxLabel">{{ slider_max | money_without_trailing_zeros | strip_html }}</bdi>
            </p>
          </price-range-slider>
        {%- endif -%}

        <div
          class="
            price-facet__highest-price
            {%- if filter_style == 'horizontal' %}
              price-facet__highest-price--horizontal
            {%- endif %}
          "
        >
          {%- capture formatted_highest_price -%}<bdi>{{ filter.range_max | money }}</bdi>{%- endcapture -%}
          {{ 'content.price_filter_html' | t: price: formatted_highest_price }}
        </div>

        {% if filter.min_value.value != null or filter.max_value.value != null %}
          {% assign has_active_values = true %}
        {% endif %}

        {% if should_render_clear %}
          <facet-clear-component
            class="clear-filter"
            tabindex="{% if has_active_values %}0{% else %}-1{% endif %}"
            on:click="/clearFilter"
            on:keydown="/clearFilter"
          >
            <div
              class="facets__clear {% if has_active_values %}facets__clear--active{% endif %}"
              ref="clearButton"
            >
              {{- 'actions.clear' | t -}}
            </div>
          </facet-clear-component>
        {% endif %}
      </price-facet-component>
    </floating-panel-component>
  </details>
{% endcapture %}
{% render 'accordion-custom-component',
  children: accordion_children,
  class: 'facets__item',
  open: is_vertical,
  open_by_default_on_desktop: is_vertical,
  open_by_default_on_mobile: is_vertical,
  disable_animation_on_desktop: is_horizontal,
  close_with_escape: is_horizontal
%}

{% stylesheet %}
  /* Price filter */
  .price-facet {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }
  .price-facet--horizontal {
    min-width: 360px;
  }

  .price-facet__inputs-wrapper {
    display: flex;
    flex-direction: row;
    padding: var(--style-border-width-inputs);
    gap: calc(var(--gap-sm) + (var(--style-border-width-inputs) * 2));
  }

  @container (max-width: 199px) {
    .price-facet__inputs-wrapper {
      flex-wrap: wrap;
    }
  }

  .price-facet__input {
    width: 100%;
    text-align: end;
    padding-inline-start: calc(2.5 * var(--input-padding-x));
  }

  .price-facet__input::placeholder {
    color: var(--facets-input-label-color);
  }

  .price-facet__separator {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-paragraph--size);
  }

  .price-facet__highest-price {
    color: var(--color-foreground-muted);
    padding: var(--padding-xs) 0 var(--padding-sm);
  }

  .price-facet__highest-price--horizontal {
    padding: 0 var(--padding-md) var(--padding-xs);
  }

  .price-facet__label {
    top: 0;
    inset-inline-start: 0;
    color: var(--facets-input-label-color);
    padding: var(--input-padding-y) var(--input-padding-x);
    transform: none;
  }

  /* Slider mode: the text fields stay in the form but the slider replaces them visually. */
  .price-facet--slider > .facets__inputs-wrapper,
  .price-facet--slider > .price-facet__highest-price {
    display: none;
  }

  .price-range {
    --price-range-thumb-size: 1rem;
    --price-range-track-height: 3px;
    --price-range-color: var(--price-range-accent, var(--color-foreground));

    display: block;
    padding-block: var(--padding-sm) var(--padding-xs);
  }

  .price-range__track {
    position: relative;
    height: var(--price-range-thumb-size);
    margin-inline: calc(var(--price-range-thumb-size) / 2);

    &::before {
      content: '';
      position: absolute;
      inset-inline: calc(var(--price-range-thumb-size) / -2);
      inset-block-start: 50%;
      height: var(--price-range-track-height);
      border-radius: var(--price-range-track-height);
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-15));
      transform: translateY(-50%);
    }
  }

  .price-range__fill {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: var(--price-range-start);
    inset-inline-end: calc(100% - var(--price-range-end));
    height: var(--price-range-track-height);
    background-color: var(--price-range-color);
    transform: translateY(-50%);
  }

  /* Both inputs overlap the track; only their thumbs take pointer events. */
  .price-range__input {
    position: absolute;
    inset: 0;
    inset-inline: calc(var(--price-range-thumb-size) / -2);
    width: calc(100% + var(--price-range-thumb-size));
    height: 100%;
    margin: 0;
    background: none;
    pointer-events: none;
    appearance: none;
    -webkit-appearance: none;

    &::-webkit-slider-runnable-track {
      background: none;
    }

    &::-webkit-slider-thumb {
      width: var(--price-range-thumb-size);
      height: var(--price-range-thumb-size);
      border: 2px solid var(--color-background);
      border-radius: 50%;
      background-color: var(--price-range-color);
      box-shadow: 0 1px 3px rgb(var(--color-foreground-rgb) / var(--opacity-20));
      cursor: grab;
      pointer-events: auto;
      appearance: none;
      -webkit-appearance: none;
    }

    &::-moz-range-track {
      background: none;
    }

    &::-moz-range-thumb {
      width: var(--price-range-thumb-size);
      height: var(--price-range-thumb-size);
      border: 2px solid var(--color-background);
      border-radius: 50%;
      background-color: var(--price-range-color);
      box-shadow: 0 1px 3px rgb(var(--color-foreground-rgb) / var(--opacity-20));
      cursor: grab;
      pointer-events: auto;
    }

    &:focus-visible {
      outline: none;
    }

    &:focus-visible::-webkit-slider-thumb {
      outline: var(--focus-outline-width) solid var(--price-range-color);
      outline-offset: 2px;
    }

    &:focus-visible::-moz-range-thumb {
      outline: var(--focus-outline-width) solid var(--price-range-color);
      outline-offset: 2px;
    }
  }

  .price-range__values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    margin: var(--margin-sm) 0 0;
    font-size: var(--font-paragraph--size);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }
{% endstylesheet %}

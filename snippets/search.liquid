{%- doc -%}
  Renders the search action button, and optionally an expandable search field for the desktop menu layout.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').
  @param {string} [bar] - Set to 'bar' to render a search icon that expands into a product search field on desktop. The modal trigger remains for the drawer layout.
  @param {string} [placeholder] - Placeholder text for the expandable search field.
  @param {number} [bar_width] - Width of the expanded search field in pixels.
  @param {string} [form_id] - Unique suffix for the expandable search field IDs.

  @example
  {% render 'search', style: 'default', class: 'custom-class', display_style: 'icon', bar: 'bar', placeholder: 'Search for...', bar_width: 400, form_id: section.id %}
{%- enddoc -%}

{% unless style == 'none' %}
  <search-button
    class="search-action{% if display_style == 'text' %} search-action--text{% endif %}{% if bar == 'bar' %} search-action--has-bar{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    {% if bar == 'bar' %}
      {%- liquid
        assign field_id = 'HeaderSearch-' | append: form_id
        assign panel_id = 'HeaderSearchPanel-' | append: form_id
        assign field_placeholder = placeholder
        if field_placeholder == blank
          assign field_placeholder = 'content.search_input_placeholder' | t
        endif
      -%}
      <script
        src="{{ 'header-search-bar.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
      <header-search-bar
        class="search-action__expandable"
        style="--header-search-bar-width: {{ bar_width | default: 400 }}px;"
      >
        {% comment %} A link to the search page until the module upgrades it into a toggle. {% endcomment %}
        <a
          href="{{ routes.search_url }}"
          class="header-actions__action search-action__toggle"
          ref="toggle"
          on:click="/open"
          aria-label="{{ 'content.search_input_label' | t }}"
          aria-controls="{{ panel_id }}"
          aria-expanded="false"
        >
          <span
            class="svg-wrapper"
            aria-hidden="true"
          >
            {{- 'icon-search.svg' | inline_asset_content -}}
          </span>
        </a>

        <form
          id="{{ panel_id }}"
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="search-action__bar"
          ref="form"
          on:submit="/handleSubmit"
          inert
        >
          <label
            for="{{ field_id }}"
            class="visually-hidden"
          >
            {{- 'content.search_input_label' | t -}}
          </label>
          <button
            type="submit"
            class="button-unstyled search-action__bar-submit"
            aria-label="{{ 'content.search' | t }}"
          >
            <span
              class="svg-wrapper"
              aria-hidden="true"
            >
              {{- 'icon-search.svg' | inline_asset_content -}}
            </span>
          </button>
          <input
            id="{{ field_id }}"
            class="search-action__bar-input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ field_placeholder | escape }}"
            autocomplete="off"
            ref="input"
          >
          <input
            type="hidden"
            name="type"
            value="product"
          >
          <input
            type="hidden"
            name="options[prefix]"
            value="last"
          >
          <button
            type="button"
            class="button-unstyled search-action__bar-close"
            on:click="/handleClose"
            aria-label="{{ 'actions.close' | t }}"
          >
            <span
              class="svg-wrapper"
              aria-hidden="true"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </form>
      </header-search-bar>
    {% endif %}

    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled header-actions__action search-action__trigger{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
        {{ 'content.search' | t }}
      </span>

      <span class="svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
  </search-button>
{% endunless %}

{% stylesheet %}
  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }

  [data-menu-style='menu'] .header__column--left .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .header__column--right .search-action--text {
      margin-inline: 0;
    }

    [data-menu-style='menu'] .header__column--left .search-action--text {
      margin-inline: 0;
    }
  }

  /* Expandable search: shown only in the desktop menu layout; the drawer layout keeps the modal trigger. */
  .search-action__expandable {
    display: none;
  }

  #header-component[data-menu-style='menu'] .search-action--has-bar {
    margin-inline: 0;

    .search-action__trigger {
      display: none;
    }

    .search-action__expandable {
      position: relative;
      display: flex;
      align-items: center;
    }

    .search-action__toggle {
      transition: opacity var(--animation-speed) var(--animation-easing);
    }

    .search-action__bar {
      --header-icon-size: var(--icon-size-md);

      position: absolute;
      inset-inline-start: 0;
      top: 50%;
      z-index: 1;
      display: flex;
      align-items: center;
      width: min(var(--header-search-bar-width), 40vw);
      padding-inline: var(--padding-2xs);
      border: var(--style-border-width-inputs) solid rgb(var(--color-foreground-rgb) / var(--opacity-30));
      border-radius: var(--style-border-radius-pills);
      color: var(--color-foreground);
      background-color: var(--color-background);
      opacity: 0;
      visibility: hidden;
      clip-path: inset(0 100% 0 0 round var(--style-border-radius-pills));
      transform: translateY(-50%);
      transition: clip-path var(--animation-speed) var(--animation-easing),
        opacity var(--animation-speed) var(--animation-easing), visibility 0s linear var(--animation-speed),
        border-color var(--animation-speed) var(--animation-easing);

      &:focus-within {
        border-color: var(--color-foreground);
      }
    }

    [dir='rtl'] & .search-action__bar {
      clip-path: inset(0 0 0 100% round var(--style-border-radius-pills));
    }

    .search-action__expandable[open] {
      .search-action__toggle {
        opacity: 0;
        pointer-events: none;
      }

      .search-action__bar {
        opacity: 1;
        visibility: visible;
        clip-path: inset(0 0 0 0 round var(--style-border-radius-pills));
        transition-delay: 0s;
      }
    }

    .search-action__bar-submit,
    .search-action__bar-close {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      min-width: var(--minimum-touch-target);
      min-height: var(--minimum-touch-target);
      color: inherit;
      background-color: transparent;

      .svg-wrapper {
        width: auto;
        height: auto;
      }
    }

    .search-action__bar-close {
      --header-icon-size: var(--icon-size-sm);
    }

    .search-action__bar-input {
      flex: 1 1 auto;
      min-width: 0;
      min-height: var(--minimum-touch-target);
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      font-size: var(--header-actions-font-size, 1rem);

      &::placeholder {
        color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
      }

      &:focus,
      &:focus-visible {
        outline: none;
        box-shadow: none;
      }

      &::-webkit-search-cancel-button {
        display: none;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #header-component .search-action__bar,
    #header-component .search-action__toggle {
      transition: none;
    }
  }
{% endstylesheet %}

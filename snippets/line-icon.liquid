{%- doc -%}
  Renders a decorative outline icon on a 24×24 grid. Strokes use currentColor, so the icon follows the
  surrounding text color. Used by the contact details and icon highlights sections.

  @param {string} icon - One of: email, phone, whatsapp, clock, map_pin, chat, headset, leaf, heart, truck, send, chevron, check, star, shield.
  @param {string} [class_name] - Class for the svg element.

  @example
  {% render 'line-icon', icon: 'email', class_name: 'contact-details__icon-svg' %}
{%- enddoc -%}

<svg
  class="{{ class_name }}"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {%- case icon -%}
    {%- when 'email' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>
    {%- when 'phone' -%}
      <path d="M8.2 3.5H5.6A1.6 1.6 0 0 0 4 5.2C4.3 13.3 10.7 19.7 18.8 20a1.6 1.6 0 0 0 1.7-1.6v-2.6a1 1 0 0 0-.8-1l-3.3-.8a1 1 0 0 0-1 .3l-1.4 1.5a12.6 12.6 0 0 1-5.8-5.8l1.5-1.4a1 1 0 0 0 .3-1l-.8-3.3a1 1 0 0 0-1-.8Z"/>
    {%- when 'whatsapp' -%}
      <path d="M4 20.5 5.2 16A8.5 8.5 0 1 1 8.4 19.2L4 20.5Z"/><path d="M9.2 8.3c.2-.4.6-.4.8-.4h.5c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .5-.1.7l-.5.6c.6 1.2 1.6 2.1 2.8 2.7l.6-.6c.2-.2.4-.2.7-.1l1.5.7c.2.1.3.3.3.5v.5c0 .3-.2.7-.5.9-.7.4-1.6.5-2.6.1a9.2 9.2 0 0 1-4.6-4.5c-.4-1-.4-2.1 0-3Z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'map_pin' -%}
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/>
    {%- when 'chat' -%}
      <path d="M20 12.5a7.5 7.5 0 0 1-11 6.6L4.5 20l1-3.9A7.5 7.5 0 1 1 20 12.5Z"/><path d="M9 11h6M9 14h4"/>
    {%- when 'headset' -%}
      <path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2"/><rect x="3.5" y="13.5" width="4" height="5.5" rx="1.5"/><rect x="16.5" y="13.5" width="4" height="5.5" rx="1.5"/><path d="M18.5 19c0 1.2-1.3 2-3.5 2h-2"/>
    {%- when 'leaf' -%}
      <path d="M19.5 4.5C10 4.5 4.5 9 4.5 15.5c0 2 1.3 4 4 4 6.5 0 11-5.5 11-15Z"/><path d="M4.5 19.5c3-4.5 6.5-8 10-10"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 7.5 2.8C19.5 15.4 12 20 12 20Z"/>
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9.5H3zM14 9.5h3.6l3.4 3.6V16h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'send' -%}
      <path d="M20.5 3.5 10 14M20.5 3.5 14 20.5l-4-6.5-6.5-4 17-6.5Z"/>
    {%- when 'chevron' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'star' -%}
      <path d="m12 3.8 2.5 5.1 5.6.8-4 4 .9 5.6-5-2.7-5 2.7.9-5.6-4-4 5.6-.8L12 3.8Z"/>
    {%- when 'shield' -%}
      <path d="M12 3.5 5 6v5.5c0 4.4 3 7.7 7 9 4-1.3 7-4.6 7-9V6l-7-2.5Z"/><path d="m9 12 2.2 2.2L15.5 10"/>
  {%- endcase -%}
</svg>

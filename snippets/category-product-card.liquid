{%- doc -%}
  Renders a product card for the category product tabs: image, title, weight or variant, rating,
  price, and a cart button. Single-variant products add straight to the cart (quick add); products with
  variants open a slide-up size picker (snippets/card-variant-picker.liquid). Renders a placeholder card
  when no product is passed.
  Styles are owned by snippets/category-product-card-styles.liquid, which this snippet renders.

  @param {product} [product] - The product to render. Omit to render a placeholder card.
  @param {string} section_id - The section ID, used for unique IDs and the quick add form.
  @param {number} [index] - Position in the grid; used to pick a placeholder image.
  With Theme settings > Product cards > "Show smallest size on cards", products with several sizes show
  their lowest-priced variant (image, size, price); the card still links to the product page, which opens
  on the default variant. "Show second image on hover" swaps in the highest-priced variant's image, or the
  product's second image. "Show From before price" prefixes the price when other variants cost more.

  @param {boolean} [show_weight] - Shows the shown variant's weight, or its title when it has no weight.
  @param {boolean} [show_rating] - Shows the product rating from the standard reviews metafields.
  @param {string} [image_sizes] - The sizes attribute for the product image.

  @example
  {% render 'category-product-card', product: product, section_id: section.id, index: forloop.index, show_weight: true, show_rating: true, image_sizes: '(min-width: 990px) 25vw, 50vw' %}
{%- enddoc -%}

{%- liquid
  assign sizes = image_sizes | default: '(min-width: 990px) 25vw, 50vw'
-%}

{% render 'category-product-card-styles' %}

{%- if product != blank -%}
  {%- liquid
    assign variant = product.selected_or_first_available_variant
    assign hover_variant = variant

    # Rank sizes by price: the cheapest is shown on the card, the dearest is the hover image.
    if product.has_only_default_variant == false
      assign variants_by_price = product.variants | where: 'available' | sort: 'price'
      if variants_by_price.size == 0
        assign variants_by_price = product.variants | sort: 'price'
      endif
      if settings.card_show_smallest_variant
        assign variant = variants_by_price.first
      endif
      assign hover_variant = variants_by_price.last
    endif

    assign card_media = variant.featured_media | default: product.featured_media
    assign hover_media = nil
    if settings.show_second_image_on_hover and card_media
      if hover_variant.featured_media and hover_variant.featured_media.id != card_media.id
        assign hover_media = hover_variant.featured_media
      else
        for media in product.media
          if media.id != card_media.id
            assign hover_media = media
            break
          endif
        endfor
      endif
    endif

    assign show_price_from = false
    if settings.card_show_price_from and variant.price < product.price_max
      assign show_price_from = true
    endif

    assign card_link_id = 'CategoryProductLink-' | append: section_id | append: '-' | append: product.id

    assign subtitle = ''
    if show_weight
      if variant.weight > 0
        # Whole weights read "130 g" rather than "130.0 g".
        assign weight_value = variant.weight_in_unit
        assign weight_whole = weight_value | floor
        if weight_value == weight_whole
          assign weight_value = weight_whole
        endif
        assign subtitle = weight_value | append: ' ' | append: variant.weight_unit
      elsif product.has_only_default_variant == false
        assign subtitle = variant.title
      endif
    endif

    assign rating = product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value
  -%}

  <product-card
    class="category-product-card"
    data-product-id="{{ product.id }}"
    {% if request.design_mode %}
      data-no-navigation
    {% endif %}
  >
    {% comment %} Stretched link: the whole card opens the product; the quick add button sits above it. {% endcomment %}
    <a
      id="{{ card_link_id }}"
      href="{{ product.url }}"
      class="category-product-card__link"
      ref="productCardLink"
      aria-label="{{ product.title | escape }}"
    ></a>

    <div class="category-product-card__media{% if hover_media %} category-product-card__media--has-hover{% endif %}">
      {%- if card_media -%}
        {{
          card_media.preview_image
          | image_url: width: 900
          | image_tag:
            widths: '300, 450, 600, 900',
            sizes: sizes,
            loading: 'lazy',
            alt: card_media.alt | default: product.title,
            class: 'category-product-card__image'
        }}
        {%- if hover_media -%}
          {{
            hover_media.preview_image
            | image_url: width: 900
            | image_tag:
              widths: '300, 450, 600, 900',
              sizes: sizes,
              loading: 'lazy',
              alt: '',
              class: 'category-product-card__image category-product-card__image--hover'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'category-product-card__image category-product-card__placeholder' }}
      {%- endif -%}
    </div>

    <div class="category-product-card__body">
      <h3 class="category-product-card__title">{{ product.title | escape }}</h3>

      {%- if subtitle != blank -%}
        <p class="category-product-card__subtitle">{{ subtitle | escape }}</p>
      {%- endif -%}

      {%- if show_rating and rating != blank and rating.rating > 0 -%}
        {%- liquid
          assign rating_value = rating.rating | times: 1.0
          assign rating_max = rating.scale_max | default: 5 | times: 1.0
          assign rating_percent = rating_value | divided_by: rating_max | times: 100 | round: 1
        -%}
        <p class="category-product-card__rating">
          <span
            class="category-product-card__stars"
            style="--rating-percent: {{ rating_percent }}%;"
            role="img"
            aria-label="{{ 'accessibility.rating' | t: rating: rating_value }}"
          ></span>
          {%- if rating_count != blank -%}
            <span class="category-product-card__rating-count">({{ rating_count }})</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      <div class="category-product-card__footer">
        {%- liquid
          # The money filter can return markup, so it is swapped in after translating rather than interpolated.
          assign display_price = variant.price | money
          if show_price_from
            assign price_from_text = 'content.price_from' | t: price: '__PRICE__'
            assign display_price = price_from_text | replace: '__PRICE__', display_price
          endif
        -%}
        <p class="category-product-card__price">
          {%- if variant.compare_at_price > variant.price -%}
            <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
            <span>{{ display_price }}</span>
            <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
            <s class="category-product-card__compare">{{ variant.compare_at_price | money }}</s>
          {%- else -%}
            <span>{{ display_price }}</span>
          {%- endif -%}
        </p>

        {%- liquid
          # Products with sizes or other options use the slide-up picker instead of the quick-add pop-up.
          # Subscriptions keep the quick-add flow, which sends them to the product page.
          assign use_variant_picker = false
          if product.has_only_default_variant == false and product.variants.size > 1
            assign use_variant_picker = true
          endif
          if product.requires_selling_plan or product.selling_plan_groups.size > 0
            assign use_variant_picker = false
          endif
        -%}
        <div class="category-product-card__quick-add{% if use_variant_picker %} category-product-card__quick-add--picker{% endif %}">
          {%- if use_variant_picker -%}
            {% render 'card-variant-picker', product: product, section_id: section_id %}
          {%- else -%}
            {% render 'quick-add', product: product, section_id: section_id %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </product-card>
{%- else -%}
  {%- liquid
    assign placeholder_index = index | default: 1 | modulo: 6 | plus: 1
    assign placeholder_name = 'product-' | append: placeholder_index
  -%}
  <div class="category-product-card category-product-card--placeholder">
    <div class="category-product-card__media">
      {{ placeholder_name | placeholder_svg_tag: 'category-product-card__image category-product-card__placeholder' }}
    </div>
    <div class="category-product-card__body">
      <h3 class="category-product-card__title">{{ 'placeholders.product_title' | t }}</h3>
      <div class="category-product-card__footer">
        <p class="category-product-card__price">{{ 1999 | money }}</p>
      </div>
    </div>
  </div>
{%- endif -%}

{% comment %}
  Section contract.
  Brand footer in three bands: a brand band (background image, logo, heading, tagline, social links),
  a certifications band (certification blocks with badge, title and text), and a closing band with link
  columns, an optional newsletter with perks, a slogan, and a bottom bar with copyright, payment icons
  and a note. Perk and certification blocks are not link columns.
  @example
  <!-- Added to the footer group. Link columns, perks and certifications are blocks. -->
{% endcomment %}

{%- liquid
  assign title_font = section.settings.title_font
  assign link_column_count = 0
  assign certification_count = 0
  for block in section.blocks
    case block.type
      when 'perk'
        continue
      when 'certification'
        assign certification_count = certification_count | plus: 1
      else
        assign link_column_count = link_column_count | plus: 1
    endcase
  endfor

  assign logo_image = section.settings.logo | default: settings.logo
  assign hero_image = section.settings.brand_background_image
  assign hero_image_mobile = section.settings.brand_background_image_mobile | default: hero_image
  assign form_id = 'BrandFooterNewsletter-' | append: section.id
  assign email_id = 'BrandFooterEmail-' | append: section.id
  assign message_id = 'BrandFooterMessage-' | append: section.id
  assign certs_color_id = section.id | append: '-certs'
  assign leaf_id = 'BrandFooterLeaf-' | append: section.id
  assign sprig_id = 'BrandFooterSprig-' | append: section.id
  assign sides = 'start,end' | split: ','
-%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  section_id: section.id
%}

{%- if certification_count > 0 -%}
  {% render 'contrast-override',
    background_color: section.settings.certifications_background,
    text_color: section.settings.certifications_text_color,
    section_id: certs_color_id
  %}
{%- endif -%}

{% comment %} Font families contain quotes, so they live here rather than in the style attribute. {% endcomment %}
{% style %}
  {{ title_font | font_face: font_display: 'swap' }}

  .brand-footer-{{ section.id }} {
    --brand-footer-font: {{ title_font.family }}, {{ title_font.fallback_families }};
    --brand-footer-font-weight: {{ title_font.weight }};
  }
{% endstyle %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="brand-footer brand-footer-{{ section.id }} color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --brand-footer-logo-width: {{ section.settings.logo_width }}px;
    --brand-footer-badge-size: {{ section.settings.certification_badge_size }}px;
    --brand-footer-badge-size-mobile: {{ section.settings.certification_badge_size_mobile }}px;
    --brand-footer-overlay: {{ section.settings.brand_overlay_opacity | divided_by: 100.0 }};
    {% if section.settings.accent_color != blank %}--brand-footer-accent: {{ section.settings.accent_color }}; --brand-footer-accent-rgb: {{ section.settings.accent_color.rgb }};{% endif %}
    {% if section.settings.button_background != blank %}--brand-footer-button-bg: {{ section.settings.button_background }};{% endif %}
    {% if section.settings.button_text_color != blank %}--brand-footer-button-text: {{ section.settings.button_text_color }};{% endif %}
    {% if section.settings.certifications_title_color != blank %}--brand-footer-cert-title: {{ section.settings.certifications_title_color }};{% endif %}
  "
>
  {%- if section.settings.show_decoration -%}
    {% comment %} One leaf drawing, reused by every illustration in the footer. {% endcomment %}
    <svg
      class="brand-footer__defs"
      aria-hidden="true"
      focusable="false"
      xmlns="http://www.w3.org/2000/svg"
    >
      <symbol
        id="{{ leaf_id }}"
        viewBox="0 0 64 24"
      >
        <g fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12C14 2 38-1 62 10 40 22 16 22 2 12Z"/>
          <path d="M2 12C22 11 42 10 62 10"/>
          <path d="M14 11.6 20 6M24 11.2 31 4.6M34 10.8 41 4.8M44 10.4 50 6.4M14 11.7 21 17M24 11.3 31 18.2M34 10.9 41 16.8M44 10.5 50 14.8"/>
        </g>
      </symbol>
      <symbol
        id="{{ sprig_id }}"
        viewBox="0 0 260 260"
      >
        <path d="M14 254C64 196 118 132 240 18" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
        <use href="#{{ leaf_id }}" width="80" height="30" x="-2" y="-15" transform="translate(44 220) rotate(-92)"/>
        <use href="#{{ leaf_id }}" width="80" height="30" x="-2" y="-15" transform="translate(58 204) rotate(-4)"/>
        <use href="#{{ leaf_id }}" width="74" height="28" x="-2" y="-14" transform="translate(92 164) rotate(-96)"/>
        <use href="#{{ leaf_id }}" width="74" height="28" x="-2" y="-14" transform="translate(108 146) rotate(-8)"/>
        <use href="#{{ leaf_id }}" width="66" height="25" x="-2" y="-12" transform="translate(142 112) rotate(-100)"/>
        <use href="#{{ leaf_id }}" width="66" height="25" x="-2" y="-12" transform="translate(160 94) rotate(-12)"/>
        <use href="#{{ leaf_id }}" width="58" height="22" x="-2" y="-11" transform="translate(192 64) rotate(-104)"/>
        <use href="#{{ leaf_id }}" width="58" height="22" x="-2" y="-11" transform="translate(206 52) rotate(-18)"/>
        <use href="#{{ leaf_id }}" width="52" height="20" x="-2" y="-10" transform="translate(236 22) rotate(-48)"/>
      </symbol>
    </svg>
  {%- endif -%}

  {%- comment -%} Brand band {%- endcomment -%}
  <div class="brand-footer__hero section section--{{ section.settings.section_width }}">
    {%- if hero_image != blank -%}
      <div
        class="brand-footer__hero-media"
        aria-hidden="true"
      >
        {{
          hero_image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2500, 3000',
            sizes: '100vw',
            loading: 'lazy',
            alt: '',
            class: 'brand-footer__hero-image brand-footer__hero-image--desktop'
        }}
        {{
          hero_image_mobile
          | image_url: width: 1500
          | image_tag:
            widths: '450, 750, 1100, 1500',
            sizes: '100vw',
            loading: 'lazy',
            alt: '',
            class: 'brand-footer__hero-image brand-footer__hero-image--mobile'
        }}
      </div>
    {%- endif -%}

    <div class="brand-footer__brand">
      <a
        href="{{ routes.root_url }}"
        class="brand-footer__logo"
      >
        {%- if section.settings.show_logo_image and logo_image != blank -%}
          {{
            logo_image
            | image_url: width: 600
            | image_tag:
              widths: '200, 300, 400, 600',
              sizes: '(min-width: 750px) 300px, 200px',
              loading: 'lazy',
              alt: shop.name,
              class: 'brand-footer__logo-image'
          }}
        {%- elsif section.settings.show_logo_image -%}
          {% comment %} Same fallback logo file as blocks/_header-logo.liquid when no logo is set. {% endcomment %}
          {% render 'asset-image',
            file: 'Sahi_Brand_Logo.png',
            alt: shop.name,
            width: 1672,
            height: 941,
            max_width: 1672,
            widths: '200, 300, 400, 600',
            sizes: '(min-width: 750px) 300px, 200px',
            class: 'brand-footer__logo-image'
          %}
        {%- else -%}
          <span class="brand-footer__logo-text">{{ section.settings.brand_name | default: shop.name | escape }}</span>
        {%- endif -%}
      </a>

      {%- if section.settings.brand_heading != blank -%}
        <p class="brand-footer__headline">{{ section.settings.brand_heading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <div class="brand-footer__tagline">{{ section.settings.tagline }}</div>
      {%- endif -%}

      {%- liquid
        assign social_platforms = 'instagram,facebook,tiktok,youtube,pinterest,twitter' | split: ','
        assign has_social = false
        for platform in social_platforms
          assign url_key = platform | append: '_url'
          if section.settings[url_key] != blank
            assign has_social = true
          endif
        endfor
      -%}
      {%- if has_social -%}
        <ul
          class="brand-footer__social"
          role="list"
        >
          {%- for platform in social_platforms -%}
            {%- assign url_key = platform | append: '_url' -%}
            {%- if section.settings[url_key] != blank -%}
              <li>
                <a
                  href="{{ section.settings[url_key] }}"
                  class="brand-footer__social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="{{ platform | capitalize }}"
                >
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    viewBox="0 0 20 20"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    {%- render 'icon', icon: platform -%}
                  </svg>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Certifications band {%- endcomment -%}
  {%- if certification_count > 0 -%}
    <div class="brand-footer__certs section section--{{ section.settings.section_width }} color-custom-{{ certs_color_id }}{% unless section.settings.certifications_text_mobile %} brand-footer__certs--compact-mobile{% endunless %}">
      {% comment %} Outside the inner wrapper so the drawings reach the band's outer edges. {% endcomment %}
      {%- for side in sides -%}
        {%- liquid
          assign art_key = 'certifications_illustration_' | append: side
          assign art_class = 'brand-footer__certs-art brand-footer__certs-art--' | append: side
        -%}
        {%- if section.settings[art_key] != blank -%}
          {{
            section.settings[art_key]
            | image_url: width: 600
            | image_tag:
              widths: '300, 450, 600',
              sizes: '15rem',
              loading: 'lazy',
              alt: '',
              class: art_class
          }}
        {%- elsif section.settings.show_decoration -%}
          <svg
            class="brand-footer__certs-leaf brand-footer__certs-leaf--{{ side }}"
            aria-hidden="true"
            focusable="false"
          >
            <use href="#{{ sprig_id }}"/>
          </svg>
        {%- endif -%}
      {%- endfor -%}

      <div class="brand-footer__certs-inner">
        {%- if section.settings.certifications_heading != blank -%}
          <h2 class="brand-footer__certs-heading">{{ section.settings.certifications_heading | escape }}</h2>
        {%- endif -%}

        <ul
          class="brand-footer__cert-list"
          role="list"
        >
          {%- for block in section.blocks -%}
            {%- if block.type != 'certification' -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign cert_alt = block.settings.alt | default: block.settings.image.alt | default: block.settings.title
            -%}
            <li
              class="brand-footer__cert"
              {{ block.shopify_attributes }}
            >
              {%- capture cert_image -%}
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag:
                      widths: '160, 240, 320, 400',
                      sizes: '200px',
                      loading: 'lazy',
                      alt: cert_alt,
                      class: 'brand-footer__cert-image'
                  }}
                {%- elsif block.settings.fallback_image != blank -%}
                  {% render 'asset-image',
                    file: block.settings.fallback_image,
                    alt: cert_alt,
                    width: 320,
                    height: 320,
                    max_width: 320,
                    widths: '160, 240, 320',
                    sizes: '10rem',
                    class: 'brand-footer__cert-image'
                  %}
                {%- endif -%}
              {%- endcapture -%}
              {%- if block.settings.link != blank -%}
                {%- assign cert_link_start = block.settings.link | slice: 0 -%}
                <a
                  href="{{ block.settings.link }}"
                  class="brand-footer__cert-link"
                  {% if cert_link_start != '/' and cert_link_start != '#' %}
                    target="_blank" rel="noopener noreferrer"
                  {% endif %}
                >
                  {{- cert_image -}}
                </a>
              {%- else -%}
                {{ cert_image }}
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="brand-footer__cert-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="brand-footer__cert-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.certifications_link != blank and section.settings.certifications_label != blank -%}
          <a
            href="{{ section.settings.certifications_link }}"
            class="brand-footer__certs-more"
          >
            {{- section.settings.certifications_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Closing band: link columns, newsletter, slogan, bottom bar {%- endcomment -%}
  <div class="brand-footer__main section section--{{ section.settings.section_width }}">
    <div class="brand-footer__main-inner">
      <div class="brand-footer__columns">
        {%- for block in section.blocks -%}
          {%- if block.type == 'perk' or block.type == 'certification' -%}
            {%- continue -%}
          {%- endif -%}
          <nav
            class="brand-footer__links"
            aria-label="{{ block.settings.heading | escape }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.heading != blank -%}
              <h2 class="brand-footer__col-title">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            <ul class="brand-footer__list">
              {%- case block.type -%}
                {%- when 'collections' -%}
                  {%- if block.settings.show_all_products -%}
                    <li><a href="{{ routes.all_products_collection_url }}">{{ block.settings.all_products_label | escape }}</a></li>
                  {%- endif -%}
                  {%- for collection in block.settings.collection_list -%}
                    <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
                  {%- endfor -%}
                {%- when 'products' -%}
                  {%- for product in block.settings.collection.products limit: block.settings.product_count -%}
                    <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                  {%- endfor -%}
                {%- when 'menu' -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
              {%- endcase -%}
            </ul>
          </nav>
        {%- endfor -%}

        {%- if section.settings.show_newsletter -%}
          <div class="brand-footer__newsletter">
            {%- if section.settings.newsletter_eyebrow != blank -%}
              <p class="brand-footer__eyebrow">{{ section.settings.newsletter_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.newsletter_heading != blank -%}
              <h2 class="brand-footer__news-title">{{ section.settings.newsletter_heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.newsletter_text != blank -%}
              <p class="brand-footer__newsletter-text">{{ section.settings.newsletter_text }}</p>
            {%- endif -%}

            {%- form 'customer', id: form_id, class: 'brand-footer__form' -%}
              <input
                type="hidden"
                name="contact[tags]"
                value="newsletter"
              >
              <div class="brand-footer__field">
                <label
                  for="{{ email_id }}"
                  class="visually-hidden"
                >
                  {{- 'blocks.email_signup.label' | t -}}
                </label>
                <input
                  id="{{ email_id }}"
                  class="brand-footer__input"
                  type="email"
                  name="contact[email]"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if section.settings.newsletter_placeholder != blank %}
                    placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                  {% else %}
                    placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
                  {% endif %}
                  required
                  {% if form.errors or form.posted_successfully? %}
                    aria-describedby="{{ message_id }}"
                  {% endif %}
                  {% if form.errors %}
                    aria-invalid="true"
                  {% endif %}
                >
                <button
                  type="submit"
                  class="brand-footer__submit"
                  aria-label="{{ 'actions.sign_up' | t }}"
                >
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    viewBox="0 0 24 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M1 8h21M15 2l7 6-7 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>

              {%- if form.errors -%}
                <p
                  id="{{ message_id }}"
                  class="brand-footer__message brand-footer__message--error"
                  role="alert"
                >
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              {%- elsif form.posted_successfully? -%}
                <p
                  id="{{ message_id }}"
                  class="brand-footer__message"
                  role="status"
                >
                  {{ 'blocks.email_signup.success' | t }}
                </p>
              {%- endif -%}
            {%- endform -%}

            {%- liquid
              assign perk_count = 0
              for block in section.blocks
                if block.type == 'perk'
                  assign perk_count = perk_count | plus: 1
                endif
              endfor
            -%}
            {%- if perk_count > 0 -%}
              <ul class="brand-footer__perks">
                {%- for block in section.blocks -%}
                  {%- if block.type != 'perk' -%}
                    {%- continue -%}
                  {%- endif -%}
                  <li
                    class="brand-footer__perk"
                    {{ block.shopify_attributes }}
                  >
                    <span
                      class="brand-footer__perk-icon"
                      aria-hidden="true"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        focusable="false"
                      >
                        <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                          {%- case block.settings.icon -%}
                            {%- when 'gift' -%}
                              <path d="M4 10h16v10H4zM3 7h18v3H3zM12 7v13"/>
                              <path d="M12 7C10 3 6 3.5 6.5 6 7 7 9 7 12 7ZM12 7c2-4 6-3.5 5.5-1-.5 1-2.5 1-5.5 1Z"/>
                            {%- when 'heart' -%}
                              <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/>
                            {%- when 'truck' -%}
                              <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/>
                              <circle cx="7" cy="17.5" r="1.8"/>
                              <circle cx="17" cy="17.5" r="1.8"/>
                            {%- when 'star' -%}
                              <path d="m12 4 2.4 5 5.4.7-4 3.7 1 5.4L12 16.2 7.2 18.8l1-5.4-4-3.7 5.4-.7Z"/>
                            {%- else -%}
                              <path d="M6 18C6 10 11 5 19 5c0 8-5 13-13 13Z"/>
                              <path d="M6 18 14 10"/>
                          {%- endcase -%}
                        </g>
                      </svg>
                    </span>
                    <span class="brand-footer__perk-label">{{ block.settings.label | escape }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.links_illustration != blank -%}
          {{
            section.settings.links_illustration
            | image_url: width: 600
            | image_tag:
              widths: '300, 450, 600',
              sizes: '15rem',
              loading: 'lazy',
              alt: '',
              class: 'brand-footer__main-art'
          }}
        {%- elsif section.settings.show_decoration -%}
          <svg
            class="brand-footer__main-leaf"
            aria-hidden="true"
            focusable="false"
          >
            <use href="#{{ sprig_id }}"/>
          </svg>
        {%- endif -%}

        {%- if section.settings.slogan != blank -%}
          <p class="brand-footer__slogan">{{ section.settings.slogan | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>

      <div class="brand-footer__bottom">
        <p class="brand-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ section.settings.copyright_text | escape }}
        </p>

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 or section.settings.closing_note != blank -%}
          <div class="brand-footer__bottom-end">
            {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
              <div class="brand-footer__payments">
                <span class="visually-hidden">{{ 'blocks.payment_methods' | t }}</span>
                <ul
                  class="brand-footer__payment-list"
                  role="list"
                >
                  {%- for type in shop.enabled_payment_types -%}
                    <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if section.settings.closing_note != blank -%}
              <p class="brand-footer__note">{{ section.settings.closing_note | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .brand-footer {
    --brand-footer-accent-color: var(--brand-footer-accent, var(--color-foreground));
    --brand-footer-accent-color-rgb: var(--brand-footer-accent-rgb, var(--color-foreground-rgb));
    --brand-footer-line: rgb(var(--brand-footer-accent-color-rgb) / var(--opacity-40));

    position: relative;
    color: var(--color-foreground);
  }

  .brand-footer__defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* !important and the extra class beat the global heading/paragraph/button font overrides in
     theme-styles-variables.liquid, so the section's font setting applies. */
  .brand-footer .brand-footer__logo-text,
  .brand-footer .brand-footer__headline,
  .brand-footer .brand-footer__tagline,
  .brand-footer .brand-footer__tagline *,
  .brand-footer .brand-footer__certs-heading,
  .brand-footer .brand-footer__cert-title,
  .brand-footer .brand-footer__list a,
  .brand-footer .brand-footer__slogan,
  .brand-footer .brand-footer__news-title,
  .brand-footer .brand-footer__newsletter-text,
  .brand-footer .brand-footer__input,
  .brand-footer .brand-footer__perk-label,
  .brand-footer .brand-footer__copyright,
  .brand-footer .brand-footer__note {
    font-family: var(--brand-footer-font) !important;
  }

  /* ---------- Brand band ---------- */
  .brand-footer__hero {
    position: relative;
    overflow: hidden;
    padding-block: max(var(--padding-block-start), 2.5rem) var(--padding-3xl);
  }

  .brand-footer__hero-media {
    grid-column: 1 / -1;
    position: absolute;
    inset: 0;
    z-index: 0;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background-color: rgb(0 0 0 / var(--brand-footer-overlay, 0));
    }
  }

  .brand-footer__hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-footer__hero-image--desktop {
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .brand-footer__hero-image--mobile {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .brand-footer__brand {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    text-align: center;
  }

  .brand-footer__logo {
    display: inline-block;
    color: var(--brand-footer-accent-color);
    text-decoration: none;
  }

  .brand-footer__logo-image {
    display: block;
    width: var(--brand-footer-logo-width);
    max-width: 100%;
    height: auto;

    @media screen and (max-width: 749px) {
      width: min(var(--brand-footer-logo-width), 11rem);
    }
  }

  .brand-footer__logo-text {
    font-weight: var(--brand-footer-font-weight);
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1;
  }

  /* Not "__heading": the theme's global heading-font rule matches class names containing "heading". */
  .brand-footer__headline {
    margin: var(--margin-md) 0 0;
    font-weight: var(--brand-footer-font-weight);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .brand-footer__tagline {
    margin-block-start: var(--margin-xs);
    font-size: clamp(1.0625rem, 1.6vw, 1.375rem);
    line-height: 1.4;
    letter-spacing: 0.06em;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-85));
    overflow-wrap: anywhere;

    p {
      margin: 0;
    }
  }

  /* Social links: round outlined icons in the accent color. */
  .brand-footer__social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-md);
    margin: var(--margin-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .brand-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--brand-footer-accent-color);
    border-radius: 50%;
    color: var(--brand-footer-accent-color);
    transition: background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);

    svg {
      width: 1.125rem;
      height: 1.125rem;
      fill: currentColor;
    }

    &:hover {
      background-color: var(--brand-footer-accent-color);
      color: var(--color-background);
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid var(--brand-footer-accent-color);
      outline-offset: var(--focus-outline-offset);
    }
  }

  /* ---------- Certifications band ---------- */
  .brand-footer__certs {
    position: relative;
    overflow: hidden;
    color: var(--color-foreground);

    /* Sections are painted transparent by base.css, so the band's color sits on its own layer. */
    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background-color: var(--color-background);
    }
  }

  .brand-footer__certs-inner {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding-block: var(--padding-2xl) var(--padding-3xl);
    text-align: center;
  }

  .brand-footer__certs-leaf {
    position: absolute;
    inset-block-start: 50%;
    width: 15rem;
    height: 15rem;
    color: var(--brand-footer-accent-color);
    opacity: var(--opacity-60);
    pointer-events: none;

    @media screen and (max-width: 989px) {
      display: none;
    }
  }

  .brand-footer__certs-leaf--start {
    inset-inline-start: -2rem;
    translate: 0 -45%;
    rotate: 8deg;
  }

  .brand-footer__certs-leaf--end {
    inset-inline-end: -2rem;
    translate: 0 -45%;
    scale: -1 1;
    rotate: -8deg;
  }

  /* Illustration images sit flush with the band's outer edges, as in the design. */
  .brand-footer__certs-art,
  .brand-footer__certs-leaf {
    /* Span every grid column so the drawings are positioned against the full band, not the page column. */
    grid-column: 1 / -1;
  }

  .brand-footer__certs-art {
    position: absolute;
    z-index: 0;
    width: clamp(11rem, 16vw, 15.5rem);
    height: auto;
    opacity: var(--opacity-85);
    pointer-events: none;

    @media screen and (max-width: 989px) {
      display: none;
    }
  }

  .brand-footer__certs-art--start {
    inset-inline-start: 0;
    inset-block-end: var(--padding-xl);
  }

  .brand-footer__certs-art--end {
    inset-inline-end: 0;
    inset-block-end: var(--padding-lg);
  }

  /* The drawings face the page edge they sit on, so they mirror with the reading direction. */
  [dir='rtl'] .brand-footer__certs-art,
  [dir='rtl'] .brand-footer__main-art {
    scale: -1 1;
  }

  .brand-footer__certs-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-xl);
    margin: 0 0 var(--margin-2xl);
    font-weight: var(--brand-footer-font-weight);
    font-size: clamp(0.9375rem, 1.4vw, 1.125rem);
    line-height: 1.3;
    letter-spacing: 0.24em;
    text-transform: uppercase;

    &::before,
    &::after {
      content: '';
      flex: 0 1 8rem;
      height: 1px;
      background-color: var(--brand-footer-accent-color);
    }

    @media screen and (max-width: 749px) {
      gap: var(--gap-sm);
      font-size: 0.8125rem;
      letter-spacing: 0.14em;

      &::before,
      &::after {
        flex-basis: 1.25rem;
        flex-shrink: 0;
      }
    }
  }

  /* One row at every width; phones get smaller badges (and optionally no titles or text). */
  .brand-footer__cert-list {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    max-width: 60rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .brand-footer__cert {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    padding-inline: var(--padding-lg);

    @media screen and (min-width: 750px) {
      & + & {
        border-inline-start: 1px solid var(--brand-footer-line);
      }
    }

    @media screen and (max-width: 749px) {
      padding-inline: var(--padding-xs);

      .brand-footer__cert-image {
        width: var(--brand-footer-badge-size-mobile);
        height: var(--brand-footer-badge-size-mobile);
      }
    }
  }

  @media screen and (max-width: 749px) {
    .brand-footer__certs--compact-mobile :is(.brand-footer__cert-title, .brand-footer__cert-text) {
      display: none;
    }
  }

  .brand-footer__cert-link {
    display: flex;
    border-radius: 50%;

    &:focus-visible {
      outline: var(--focus-outline-width) solid var(--brand-footer-accent-color);
      outline-offset: var(--focus-outline-offset);
    }
  }

  .brand-footer__cert-image {
    display: block;
    width: var(--brand-footer-badge-size);
    max-width: 100%;
    height: var(--brand-footer-badge-size);
    object-fit: contain;
  }

  .brand-footer__cert-title {
    margin: var(--margin-md) 0 var(--margin-2xs);
    font-weight: var(--brand-footer-font-weight);
    font-size: clamp(1.5rem, 2.2vw, 1.875rem);
    line-height: 1.15;
    color: var(--brand-footer-cert-title, var(--color-foreground));
  }

  .brand-footer__cert-text {
    max-width: 15rem;
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
  }

  .brand-footer__certs-more {
    display: inline-block;
    margin-block-start: var(--margin-xl);
    font-size: 0.9375rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
    transition: text-decoration-color var(--animation-speed) var(--animation-easing);

    &:hover {
      text-decoration-color: currentColor;
    }
  }

  /* ---------- Closing band ---------- */
  .brand-footer__main {
    padding-block: var(--padding-2xl) var(--padding-block-end);
  }

  .brand-footer__main-inner {
    min-width: 0;
  }

  .brand-footer__columns {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-2xl) var(--gap-xl);
    padding-block-end: var(--padding-2xl);

    > .brand-footer__newsletter,
    > .brand-footer__slogan {
      grid-column: 1 / -1;
    }

    @media screen and (min-width: 990px) {
      display: flex;
      align-items: flex-start;
      gap: 0;

      > .brand-footer__links {
        flex: 0 1 auto;
        min-width: 12rem;
        padding-inline-end: var(--padding-4xl);
      }

      > .brand-footer__links + .brand-footer__links {
        padding-inline-start: var(--padding-4xl);
        border-inline-start: 1px solid var(--brand-footer-line);
      }

      > .brand-footer__newsletter {
        flex: 1 1 22rem;
        padding-inline-start: var(--padding-4xl);
      }
    }
  }

  .brand-footer__col-title {
    margin: 0 0 var(--margin-lg);
    padding-block-end: var(--padding-sm);
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.2;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brand-footer-accent-color);
    background: linear-gradient(var(--brand-footer-accent-color), var(--brand-footer-accent-color)) no-repeat start bottom / 2.5rem 1px;
  }

  .brand-footer__list {
    display: grid;
    gap: var(--gap-xs);
    margin: 0;
    padding: 0;
    list-style: none;

    a {
      font-size: 1.3125rem;
      line-height: 1.35;
      color: var(--color-foreground);
      text-decoration: none;
      transition: color var(--animation-speed) var(--animation-easing);

      &:hover {
        color: var(--brand-footer-accent-color);
      }
    }
  }

  .brand-footer__main-leaf {
    display: none;

    @media screen and (min-width: 990px) {
      display: block;
      flex: 1 1 auto;
      align-self: stretch;
      max-width: 15rem;
      height: 9rem;
      margin-inline-start: auto;
      color: var(--brand-footer-accent-color);
      opacity: var(--opacity-60);
      rotate: 40deg;
      pointer-events: none;
    }
  }

  /* The sprig's stem runs down to the rule above the copyright, as in the design. */
  .brand-footer__main-art {
    display: none;

    @media screen and (min-width: 990px) {
      display: block;
      flex: 0 1 15rem;
      align-self: flex-end;
      width: 15rem;
      min-width: 0;
      height: auto;
      margin-inline-start: auto;
      margin-block-end: calc(var(--padding-2xl) * -1);
      opacity: var(--opacity-85);
      pointer-events: none;
    }
  }

  .brand-footer__slogan {
    margin: 0;
    padding-block-end: var(--padding-md);
    font-style: italic;
    font-weight: var(--brand-footer-font-weight);
    font-size: clamp(1.75rem, 2.8vw, 2.5rem);
    line-height: 1.15;
    text-align: center;
    background: linear-gradient(var(--brand-footer-accent-color), var(--brand-footer-accent-color)) no-repeat center bottom / 3rem 1px;

    @media screen and (min-width: 990px) {
      flex: 0 0 auto;
      margin-inline-start: var(--padding-2xl);
      align-self: center;
    }
  }

  .brand-footer__eyebrow {
    margin: 0 0 var(--margin-sm);
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
  }

  .brand-footer__news-title {
    margin: 0 0 var(--margin-sm);
    font-weight: var(--brand-footer-font-weight);
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    line-height: 1.1;
    color: var(--brand-footer-accent-color);
  }

  .brand-footer__newsletter-text {
    margin: 0 0 var(--margin-lg);
    max-width: 26rem;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-85));
  }

  .brand-footer__field {
    display: flex;
    max-width: 30rem;
    border: 1px solid rgb(var(--brand-footer-accent-color-rgb) / var(--opacity-40));
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
    background-color: rgb(var(--brand-footer-accent-color-rgb) / var(--opacity-10));

    &:focus-within {
      border-color: var(--brand-footer-accent-color);
    }
  }

  /* The ID-free class pair plus !important beat the theme's global input field colors,
     which would otherwise paint a light field on the dark footer. */
  .brand-footer .brand-footer__input {
    border: 0 !important;
    background: transparent !important;
    color: var(--color-foreground) !important;
    box-shadow: none !important;
  }

  .brand-footer__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0 var(--padding-lg);
    font-size: 1rem;

    &::placeholder {
      color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    }

    &:focus,
    &:focus-visible {
      outline: none;
      box-shadow: none;
    }
  }

  .brand-footer__submit {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    padding: 0;
    border: 0;
    background-color: var(--brand-footer-button-bg, var(--brand-footer-accent-color));
    color: var(--brand-footer-button-text, var(--color-background));
    cursor: pointer;
    transition: opacity var(--animation-speed) var(--animation-easing);

    svg {
      width: 1.5rem;
      height: 1rem;
      transition: transform var(--animation-speed) var(--animation-easing);
    }

    &:hover {
      opacity: var(--opacity-85);

      svg {
        transform: translateX(0.2rem);
      }
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid var(--brand-footer-accent-color);
      outline-offset: calc(var(--focus-outline-width) * -1);
    }
  }

  [dir='rtl'] .brand-footer__submit svg {
    scale: -1 1;
  }

  .brand-footer__message {
    margin: var(--margin-sm) 0 0;
    font-size: 0.9375rem;
    color: var(--brand-footer-accent-color);
  }

  .brand-footer__perks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-md) var(--gap-xl);
    margin: var(--margin-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .brand-footer__perk {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
  }

  .brand-footer__perk-icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(var(--brand-footer-accent-color-rgb) / var(--opacity-60));
    border-radius: 50%;
    color: var(--brand-footer-accent-color);

    svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  .brand-footer__perk-label {
    max-width: 5.5rem;
    font-size: 0.875rem;
    line-height: 1.25;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-85));
  }

  /* Bottom bar */
  .brand-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md);
    padding-block-start: var(--padding-lg);
    border-block-start: 1px solid var(--brand-footer-line);
    text-align: center;

    @media screen and (min-width: 750px) {
      flex-direction: row;
      justify-content: space-between;
      text-align: start;
    }
  }

  .brand-footer__copyright,
  .brand-footer__note {
    margin: 0;
    font-size: 1.0625rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-85));
  }

  .brand-footer__bottom-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--gap-md) var(--gap-2xl);
  }

  .brand-footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-xs);
    margin: 0;
    padding: 0;
    list-style: none;

    svg {
      display: block;
      width: 2.375rem;
      height: auto;
    }
  }

  .brand-footer__note {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-md);

    /* The leading rule only shows from 750px, so the note stays truly centered on phones. */
    &::before {
      content: '';
      display: none;
      width: 2.5rem;
      height: 1px;
      background-color: var(--brand-footer-line);

      @media screen and (min-width: 750px) {
        display: block;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-footer__social-link,
    .brand-footer__list a,
    .brand-footer__submit,
    .brand-footer__submit svg,
    .brand-footer__certs-more {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.brand_footer",
  "class": "brand-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 10,
  "blocks": [
    {
      "type": "collections",
      "name": "t:names.collection_list",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Shop"
        },
        {
          "type": "checkbox",
          "id": "show_all_products",
          "label": "t:settings.show_all_products",
          "default": true
        },
        {
          "type": "text",
          "id": "all_products_label",
          "label": "t:settings.label",
          "default": "All Products",
          "visible_if": "{{ block.settings.show_all_products }}"
        },
        {
          "type": "collection_list",
          "id": "collection_list",
          "label": "t:settings.collection_list",
          "limit": 10
        }
      ]
    },
    {
      "type": "products",
      "name": "t:names.footer_products",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Best Sellers"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "range",
          "id": "product_count",
          "label": "t:settings.product_count",
          "min": 2,
          "max": 10,
          "step": 1,
          "default": 6
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:names.menu",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:settings.menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "perk",
      "name": "t:names.footer_perk",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:settings.icon",
          "options": [
            {
              "value": "leaf",
              "label": "t:options.leaf"
            },
            {
              "value": "gift",
              "label": "t:options.gift"
            },
            {
              "value": "heart",
              "label": "t:options.heart"
            },
            {
              "value": "truck",
              "label": "t:options.truck"
            },
            {
              "value": "star",
              "label": "t:options.star"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.label",
          "default": "Exclusive Offers"
        }
      ]
    },
    {
      "type": "certification",
      "name": "t:names.footer_certification",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "t:settings.fallback_image",
          "info": "t:info.fallback_image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:settings.text"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:settings.alt_text",
          "info": "t:info.certification_alt"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.logo"
    },
    {
      "type": "checkbox",
      "id": "show_logo_image",
      "label": "t:settings.show_logo_image",
      "info": "t:info.brand_footer_logo",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:settings.logo",
      "visible_if": "{{ section.settings.show_logo_image }}"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:settings.width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160,
      "visible_if": "{{ section.settings.show_logo_image }}"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "t:settings.brand_name",
      "visible_if": "{{ section.settings.show_logo_image == false }}"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "t:settings.heading",
      "default": "Your Favourite Foods. Done Right."
    },
    {
      "type": "richtext",
      "id": "tagline",
      "label": "t:settings.tagline",
      "default": "<p>Real ingredients. A brighter tomorrow. We create natural, wholesome essentials that bring goodness to everyday life.</p>"
    },
    {
      "type": "header",
      "content": "t:content.background_image"
    },
    {
      "type": "image_picker",
      "id": "brand_background_image",
      "label": "t:settings.image"
    },
    {
      "type": "image_picker",
      "id": "brand_background_image_mobile",
      "label": "t:settings.mobile_image",
      "visible_if": "{{ section.settings.brand_background_image != blank }}"

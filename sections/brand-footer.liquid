{% comment %}
  Section contract.
  Brand footer: logo, tagline, and social links; link columns (collections, products from a collection,
  or a menu); a newsletter sign-up with perks; and a bottom bar with copyright, certification badges,
  payment icons, and a note. Perk and certification blocks are not link columns.
  @example
  <!-- Added to the footer group. Link columns and perks are blocks. -->
{% endcomment %}

{%- liquid
  assign title_font = section.settings.title_font
  assign link_column_count = 0
  assign certification_count = 0
  for block in section.blocks
    case block.type
      when 'perk'
        continue
      when 'certification'
        assign certification_count = certification_count | plus: 1
      else
        assign link_column_count = link_column_count | plus: 1
    endcase
  endfor
  if link_column_count < 1
    assign link_column_count = 1
  endif

  assign logo_image = section.settings.logo | default: settings.logo
  assign form_id = 'BrandFooterNewsletter-' | append: section.id
  assign email_id = 'BrandFooterEmail-' | append: section.id
  assign message_id = 'BrandFooterMessage-' | append: section.id
-%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  section_id: section.id
%}

{% comment %} Font families contain quotes, so they live here rather than in the style attribute. {% endcomment %}
{% style %}
  {{ title_font | font_face: font_display: 'swap' }}

  .brand-footer-{{ section.id }} {
    --brand-footer-font: {{ title_font.family }}, {{ title_font.fallback_families }};
    --brand-footer-font-weight: {{ title_font.weight }};
  }
{% endstyle %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="brand-footer brand-footer-{{ section.id }} spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --brand-footer-link-columns: {{ link_column_count }};
    --brand-footer-logo-width: {{ section.settings.logo_width }}px;
    {% if section.settings.accent_color != blank %}--brand-footer-accent: {{ section.settings.accent_color }}; --brand-footer-accent-rgb: {{ section.settings.accent_color.rgb }};{% endif %}
    {% if section.settings.button_background != blank %}--brand-footer-button-bg: {{ section.settings.button_background }};{% endif %}
    {% if section.settings.button_text_color != blank %}--brand-footer-button-text: {{ section.settings.button_text_color }};{% endif %}
  "
>
  <div class="brand-footer__inner">
    {%- if section.settings.show_decoration -%}
      <svg
        class="brand-footer__decoration"
        aria-hidden="true"
        focusable="false"
        viewBox="0 0 160 220"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 216C40 170 62 120 96 78C112 58 128 42 150 30"/>
          <path d="M44 162C20 150 10 124 14 98C38 106 52 130 44 162Z"/>
          <path d="M44 162C34 140 24 120 14 98"/>
          <path d="M36 150L22 140M30 132L18 126M26 116L16 112"/>
          <path d="M64 128C64 100 80 78 104 68C108 94 92 118 64 128Z"/>
          <path d="M64 128C78 108 90 88 104 68"/>
          <path d="M74 112L66 100M84 98L78 86M94 84L90 74"/>
          <path d="M70 118C46 118 28 104 22 82"/>
          <path d="M96 78C88 54 96 30 116 14C126 38 118 62 96 78Z"/>
          <path d="M96 78C104 58 110 36 116 14"/>
          <path d="M100 62L94 54M106 46L100 38"/>
          <path d="M120 50C140 36 156 36 158 38C150 54 134 60 120 50Z"/>
          <path d="M120 50C132 46 144 42 158 38"/>
        </g>
      </svg>
    {%- endif -%}

    <div class="brand-footer__columns">
      {%- comment -%} Brand column {%- endcomment -%}
      <div class="brand-footer__brand">
        <a
          href="{{ routes.root_url }}"
          class="brand-footer__logo"
        >
          {%- if section.settings.show_logo_image and logo_image != blank -%}
            {{
              logo_image
              | image_url: width: 600
              | image_tag:
                widths: '200, 300, 400, 600',
                sizes: '(min-width: 750px) 200px, 160px',
                loading: 'lazy',
                alt: shop.name,
                class: 'brand-footer__logo-image'
            }}
          {%- elsif section.settings.show_logo_image -%}
            {% comment %} Same fallback logo file as blocks/_header-logo.liquid when no logo is set. {% endcomment %}
            <img
              src="{{ 'Sahi_Brand_Logo.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              width="1672"
              height="941"
              class="brand-footer__logo-image"
              loading="lazy"
            >
          {%- else -%}
            <span class="brand-footer__logo-text">{{ section.settings.brand_name | default: shop.name | escape }}</span>
          {%- endif -%}
        </a>

        {%- if section.settings.tagline != blank -%}
          <div class="brand-footer__tagline">{{ section.settings.tagline }}</div>
        {%- endif -%}

        {%- liquid
          assign social_platforms = 'instagram,facebook,tiktok,youtube,pinterest,twitter' | split: ','
          assign has_social = false
          for platform in social_platforms
            assign url_key = platform | append: '_url'
            if section.settings[url_key] != blank
              assign has_social = true
            endif
          endfor
        -%}
        {%- if has_social -%}
          <ul
            class="brand-footer__social"
            role="list"
          >
            {%- for platform in social_platforms -%}
              {%- assign url_key = platform | append: '_url' -%}
              {%- if section.settings[url_key] != blank -%}
                <li>
                  <a
                    href="{{ section.settings[url_key] }}"
                    class="brand-footer__social-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="{{ platform | capitalize }}"
                  >
                    <svg
                      aria-hidden="true"
                      focusable="false"
                      viewBox="0 0 20 20"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      {%- render 'icon', icon: platform -%}
                    </svg>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Link columns {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'perk' or block.type == 'certification' -%}
          {%- continue -%}
        {%- endif -%}
        <nav
          class="brand-footer__links"
          aria-label="{{ block.settings.heading | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.heading != blank -%}
            <h2 class="brand-footer__col-title">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          <ul class="brand-footer__list">
            {%- case block.type -%}
              {%- when 'collections' -%}
                {%- if block.settings.show_all_products -%}
                  <li><a href="{{ routes.all_products_collection_url }}">{{ block.settings.all_products_label | escape }}</a></li>
                {%- endif -%}
                {%- for collection in block.settings.collection_list -%}
                  <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
                {%- endfor -%}
              {%- when 'products' -%}
                {%- for product in block.settings.collection.products limit: block.settings.product_count -%}
                  <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                {%- endfor -%}
              {%- when 'menu' -%}
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
            {%- endcase -%}
          </ul>
        </nav>
      {%- endfor -%}

      {%- comment -%} Newsletter column {%- endcomment -%}
      {%- if section.settings.show_newsletter -%}
        <div class="brand-footer__newsletter">
          {%- if section.settings.newsletter_eyebrow != blank -%}
            <p class="brand-footer__eyebrow">{{ section.settings.newsletter_eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="brand-footer__news-title">{{ section.settings.newsletter_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <p class="brand-footer__newsletter-text">{{ section.settings.newsletter_text }}</p>
          {%- endif -%}

          {%- form 'customer', id: form_id, class: 'brand-footer__form' -%}
            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >
            <div class="brand-footer__field">
              <label
                for="{{ email_id }}"
                class="visually-hidden"
              >
                {{- 'blocks.email_signup.label' | t -}}
              </label>
              <input
                id="{{ email_id }}"
                class="brand-footer__input"
                type="email"
                name="contact[email]"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if section.settings.newsletter_placeholder != blank %}
                  placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                {% else %}
                  placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
                {% endif %}
                required
                {% if form.errors or form.posted_successfully? %}
                  aria-describedby="{{ message_id }}"
                {% endif %}
                {% if form.errors %}
                  aria-invalid="true"
                {% endif %}
              >
              <button
                type="submit"
                class="brand-footer__submit"
                aria-label="{{ 'actions.sign_up' | t }}"
              >
                <svg
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M1 8h21M15 2l7 6-7 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>

            {%- if form.errors -%}
              <p
                id="{{ message_id }}"
                class="brand-footer__message brand-footer__message--error"
                role="alert"
              >
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- elsif form.posted_successfully? -%}
              <p
                id="{{ message_id }}"
                class="brand-footer__message"
                role="status"
              >
                {{ 'blocks.email_signup.success' | t }}
              </p>
            {%- endif -%}
          {%- endform -%}

          {%- liquid
            assign perk_count = 0
            for block in section.blocks
              if block.type == 'perk'
                assign perk_count = perk_count | plus: 1
              endif
            endfor
          -%}
          {%- if perk_count > 0 -%}
            <ul class="brand-footer__perks">
              {%- for block in section.blocks -%}
                {%- if block.type != 'perk' -%}
                  {%- continue -%}
                {%- endif -%}
                <li
                  class="brand-footer__perk"
                  {{ block.shopify_attributes }}
                >
                  <span
                    class="brand-footer__perk-icon"
                    aria-hidden="true"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      focusable="false"
                    >
                      <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                        {%- case block.settings.icon -%}
                          {%- when 'gift' -%}
                            <path d="M4 10h16v10H4zM3 7h18v3H3zM12 7v13"/>
                            <path d="M12 7C10 3 6 3.5 6.5 6 7 7 9 7 12 7ZM12 7c2-4 6-3.5 5.5-1-.5 1-2.5 1-5.5 1Z"/>
                          {%- when 'heart' -%}
                            <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/>
                          {%- when 'truck' -%}
                            <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/>
                            <circle cx="7" cy="17.5" r="1.8"/>
                            <circle cx="17" cy="17.5" r="1.8"/>
                          {%- when 'star' -%}
                            <path d="m12 4 2.4 5 5.4.7-4 3.7 1 5.4L12 16.2 7.2 18.8l1-5.4-4-3.7 5.4-.7Z"/>
                          {%- else -%}
                            <path d="M6 18C6 10 11 5 19 5c0 8-5 13-13 13Z"/>
                            <path d="M6 18 14 10"/>
                        {%- endcase -%}
                      </g>
                    </svg>
                  </span>
                  <span class="brand-footer__perk-label">{{ block.settings.label | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="brand-footer__bottom">
      <div class="brand-footer__bottom-start">
        <p class="brand-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ section.settings.copyright_text | escape }}
        </p>

        {%- if certification_count > 0 -%}
          <ul
            class="brand-footer__certifications"
            role="list"
          >
            {%- for block in section.blocks -%}
              {%- if block.type != 'certification' -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign cert_alt = block.settings.alt | default: block.settings.image.alt
              -%}
              <li
                class="brand-footer__certification"
                {{ block.shopify_attributes }}
              >
                {%- capture cert_image -%}
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 320
                      | image_tag:
                        widths: '160, 240, 320',
                        sizes: '7rem',
                        loading: 'lazy',
                        alt: cert_alt,
                        class: 'brand-footer__certification-image'
                    }}
                  {%- elsif block.settings.fallback_image != blank -%}
                    <img
                      src="{{ block.settings.fallback_image | asset_url }}"
                      alt="{{ cert_alt | escape }}"
                      width="320"
                      height="174"
                      loading="lazy"
                      class="brand-footer__certification-image"
                    >
                  {%- endif -%}
                {%- endcapture -%}
                {%- if block.settings.link != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="brand-footer__certification-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {{- cert_image -}}
                  </a>
                {%- else -%}
                  {{ cert_image }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="brand-footer__bottom-end">
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="brand-footer__payments">
            <span class="visually-hidden">{{ 'blocks.payment_methods' | t }}</span>
            <ul
              class="brand-footer__payment-list"
              role="list"
            >
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.closing_note != blank -%}
          <p class="brand-footer__note">{{ section.settings.closing_note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .brand-footer {
    --brand-footer-accent-color: var(--brand-footer-accent, var(--color-foreground));
    --brand-footer-accent-color-rgb: var(--brand-footer-accent-rgb, var(--color-foreground-rgb));
    --brand-footer-line: rgb(var(--brand-footer-accent-color-rgb) / var(--opacity-20));

    color: var(--color-foreground);
  }

  /* The footer is the positioning context so the leaf can sit in its very bottom-left corner. */
  .brand-footer {
    position: relative;
    overflow: hidden;
  }

  .brand-footer__inner {
    min-width: 0;
  }

  .brand-footer__decoration {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    width: 7rem;
    height: auto;
    color: var(--brand-footer-accent-color);
    opacity: var(--opacity-40);
    pointer-events: none;

    @media screen and (max-width: 989px) {
      display: none;
    }
  }

  [dir='rtl'] .brand-footer__decoration {
    scale: -1 1;
  }

  /* Columns: brand, link columns, newsletter. Stacked on mobile and tablet. */
  .brand-footer__columns,
  .brand-footer__bottom {
    position: relative;
    z-index: 1;
  }

  .brand-footer__columns {
    display: grid;
    grid-template-columns: repeat(var(--brand-footer-link-columns), minmax(0, 1fr));
    gap: var(--gap-2xl) var(--gap-xl);
    padding-block-end: var(--padding-2xl);

    > .brand-footer__brand,
    > .brand-footer__newsletter {
      grid-column: 1 / -1;
    }

    @media screen and (min-width: 990px) {
      grid-template-columns:
        minmax(0, 1.35fr)
        repeat(var(--brand-footer-link-columns), minmax(0, 0.75fr))
        minmax(0, 1.6fr);
      gap: 0;

      > .brand-footer__brand,
      > .brand-footer__newsletter {
        grid-column: auto;
      }

      > * + * {
        padding-inline-start: var(--padding-3xl);
        border-inline-start: 1px solid var(--brand-footer-line);
      }

      > *:not(:last-child) {
        padding-inline-end: var(--padding-2xl);
      }
    }
  }

  .brand-footer__newsletter {
    @media screen and (max-width: 989px) {
      padding-block-start: var(--padding-xl);
      border-block-start: 1px solid var(--brand-footer-line);
    }
  }

  /* !important and the extra class beat the global heading/paragraph/button font overrides in
     theme-styles-variables.liquid, so the section's font setting applies. */
  .brand-footer .brand-footer__logo-text,
  .brand-footer .brand-footer__tagline,
  .brand-footer .brand-footer__tagline *,
  .brand-footer .brand-footer__col-title,
  .brand-footer .brand-footer__list a,
  .brand-footer .brand-footer__news-title,
  .brand-footer .brand-footer__newsletter-text,
  .brand-footer .brand-footer__input,
  .brand-footer .brand-footer__perk-label,
  .brand-footer .brand-footer__copyright,
  .brand-footer .brand-footer__note {
    font-family: var(--brand-footer-font) !important;
  }

  .brand-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-lg);
  }

  .brand-footer__logo {
    display: inline-block;
    color: var(--brand-footer-accent-color);
    text-decoration: none;
  }

  .brand-footer__logo-image {
    display: block;
    width: var(--brand-footer-logo-width);
    max-width: 100%;
    height: auto;
  }

  .brand-footer__logo-text {
    font-weight: var(--brand-footer-font-weight);
    font-size: clamp(2.75rem, 4vw, 3.75rem);
    line-height: 1;
  }

  .brand-footer__tagline {
    max-width: 20rem;
    font-size: 1rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-85));

    p {
      margin: 0;
    }
  }

  /* Social links: round outlined icons in the accent color. */
  .brand-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(var(--brand-footer-accent-color-rgb) / var(--opacity-60));
    border-radius: 50%;
    color: var(--brand-footer-accent-color);
    transition: background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);

    svg {
      width: 1rem;
      height: 1rem;
      fill: currentColor;
    }

    &:hover {
      background-color: var(--brand-footer-accent-color);
      color: var(--color-background);
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid var(--brand-footer-accent-color);
      outline-offset: var(--focus-outline-offset);
    }
  }

  .brand-footer__col-title {
    margin: 0 0 var(--margin-lg);
    font-weight: var(--brand-footer-font-weight);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--brand-footer-accent-color);
  }

  .brand-footer__list {
    display: grid;
    gap: var(--gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;

    a {
      font-size: 1rem;
      line-height: 1.3;
      color: rgb(var(--color-foreground-rgb) / var(--opacity-85));
      text-decoration: none;
      transition: color var(--animation-speed) var(--animation-easing);

      &:hover {
        color: var(--brand-footer-accent-color);
      }
    }
  }

  .brand-footer__eyebrow {
    margin: 0 0 var(--margin-sm);
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
  }

  .brand-footer__news-title {
    margin: 0 0 var(--margin-sm);
    font-weight: var(--brand-footer-font-weight);
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    line-height: 1.1;
    color: var(--brand-footer-accent-color);
  }

  .brand-footer__newsletter-text {
    margin: 0 0 var(--margin-lg);
    max-width: 26rem;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-85));
  }

  .brand-footer__field {
    display: flex;
    max-width: 30rem;
    border: 1px solid rgb(var(--brand-footer-accent-color-rgb) / var(--opacity-40));
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
    background-color: rgb(var(--brand-footer-accent-color-rgb) / var(--opacity-10));

    &:focus-within {
      border-color: var(--brand-footer-accent-color);
    }
  }

  /* The ID-free class pair plus !important beat the theme's global input field colors,
     which would otherwise paint a light field on the dark footer. */
  .brand-footer .brand-footer__input {
    border: 0 !important;
    background: transparent !important;
    color: var(--color-foreground) !important;
    box-shadow: none !important;
  }

  .brand-footer__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0 var(--padding-lg);
    font-size: 1rem;

    &::placeholder {
      color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    }

    &:focus,
    &:focus-visible {
      outline: none;
      box-shadow: none;
    }
  }

  .brand-footer__submit {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    padding: 0;
    border: 0;
    background-color: var(--brand-footer-button-bg, var(--brand-footer-accent-color));
    color: var(--brand-footer-button-text, var(--color-background));
    cursor: pointer;
    transition: opacity var(--animation-speed) var(--animation-easing);

    svg {
      width: 1.5rem;
      height: 1rem;
      transition: transform var(--animation-speed) var(--animation-easing);
    }

    &:hover {
      opacity: var(--opacity-85);

      svg {
        transform: translateX(0.2rem);
      }
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid var(--brand-footer-accent-color);
      outline-offset: calc(var(--focus-outline-width) * -1);
    }
  }

  [dir='rtl'] .brand-footer__submit svg {
    scale: -1 1;
  }

  .brand-footer__message {
    margin: var(--margin-sm) 0 0;
    font-size: 0.9375rem;
    color: var(--brand-footer-accent-color);
  }

  .brand-footer__perks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-md) var(--gap-xl);
    margin: var(--margin-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .brand-footer__perk {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
  }

  .brand-footer__perk-icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(var(--brand-footer-accent-color-rgb) / var(--opacity-60));
    border-radius: 50%;
    color: var(--brand-footer-accent-color);

    svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  .brand-footer__perk-label {
    max-width: 5.5rem;
    font-size: 0.875rem;
    line-height: 1.25;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-85));
  }

  /* Bottom bar */
  .brand-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md);
    padding-block-start: var(--padding-lg);
    border-block-start: 1px solid var(--brand-footer-line);
    text-align: center;

    @media screen and (min-width: 750px) {
      flex-direction: row;
      justify-content: space-between;
      text-align: start;
    }
  }

  .brand-footer__copyright,
  .brand-footer__note {
    margin: 0;
    font-size: 0.9375rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
  }

  /* Copyright with certification badges beside it; stacked and centered on mobile. */
  .brand-footer__bottom-start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--gap-md) var(--gap-lg);

    @media screen and (min-width: 750px) {
      justify-content: flex-start;
    }
  }

  .brand-footer__certifications {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand-footer__certification {
    display: flex;
  }

  .brand-footer__certification-link {
    display: flex;
    border-radius: 2px;

    &:focus-visible {
      outline: var(--focus-outline-width) solid var(--brand-footer-accent-color);
      outline-offset: var(--focus-outline-offset);
    }
  }

  .brand-footer__certification-image {
    display: block;
    width: auto;
    height: var(--brand-footer-cert-height, 2.5rem);
    border-radius: 2px;
  }

  .brand-footer__bottom-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--gap-md) var(--gap-2xl);
  }

  .brand-footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-xs);
    margin: 0;
    padding: 0;
    list-style: none;

    svg {
      display: block;
      width: 2.375rem;
      height: auto;
    }
  }

  .brand-footer__note {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-md);

    &::before {
      content: '';
      width: 2.5rem;
      height: 1px;
      background-color: var(--brand-footer-line);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-footer__social-link,
    .brand-footer__list a,
    .brand-footer__submit,
    .brand-footer__submit svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}

{% comment %}
  Section contract.
  A row of category cards (image, title, underlined link) separated by soft vertical dividers.
  One column per category from tablet up, and a horizontally scrolling row on mobile.
  @example
  <!-- Add "Category showcase" to a template, then add up to 8 Category blocks -->
{% endcomment %}

{%- liquid
  assign title_font = section.settings.title_font
  assign item_count = section.blocks.size
  if item_count < 1
    assign item_count = 1
  endif
-%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  section_id: section.id
%}

{% comment %} Font families contain quotes, so they live here rather than in the style attribute. {% endcomment %}
{% style %}
  {{ title_font | font_face: font_display: 'swap' }}

  .category-showcase-{{ section.id }} {
    --category-showcase-title-font: {{ title_font.family }}, {{ title_font.fallback_families }};
    --category-showcase-title-weight: {{ title_font.weight }};
    --category-showcase-title-style: {{ title_font.style }};
  }
{% endstyle %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="category-showcase category-showcase-{{ section.id }} spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}{% if section.settings.show_dividers %} category-showcase--dividers{% endif %}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --category-showcase-columns: {{ item_count }};
    --category-showcase-image-height: {{ section.settings.image_height }}px;
    --category-showcase-title-size: {{ section.settings.title_size }}px;
    --category-showcase-title-case: {{ section.settings.title_case }};
    {% if section.settings.underline_color != blank %}
      --category-showcase-underline: {{ section.settings.underline_color }};
    {% endif %}
    {% if section.settings.divider_color != blank %}
      --category-showcase-divider-rgb: {{ section.settings.divider_color.rgb }};
    {% endif %}
  "
>
  <div class="category-showcase__list">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .category-showcase {
    --category-showcase-gap: var(--gap-md);

    position: relative;
    color: var(--color-foreground);
  }

  .category-showcase__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(10.5rem, 42%);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 750px) {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--category-showcase-columns), minmax(0, 1fr));
      overflow: visible;
    }
  }

  .category-showcase__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    padding-inline: var(--category-showcase-gap);
    text-align: center;
    scroll-snap-align: start;
  }

  /* Soft vertical divider between items that fades out at both ends. */
  .category-showcase--dividers .category-showcase__item + .category-showcase__item::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(var(--category-showcase-divider-rgb, var(--color-foreground-rgb)) / var(--opacity-20)) 20%,
      rgb(var(--category-showcase-divider-rgb, var(--color-foreground-rgb)) / var(--opacity-20)) 80%,
      transparent
    );
  }

  .category-showcase__media-link {
    display: block;
    width: 100%;
    color: inherit;
  }

  .category-showcase__media {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: var(--category-showcase-image-height);
  }

  .category-showcase__image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    transition: transform var(--animation-speed-slow) var(--animation-easing);
  }

  .category-showcase__placeholder {
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  /* !important and the extra class beat the global heading font override in theme-styles-variables.liquid,
     so the section's font setting applies. */
  .category-showcase .category-showcase__title {
    font-family: var(--category-showcase-title-font) !important;
  }

  .category-showcase__title {
    margin: var(--margin-md) 0 0;
    font-weight: var(--category-showcase-title-weight);
    font-style: var(--category-showcase-title-style);
    font-size: calc(var(--category-showcase-title-size) * 0.85);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: var(--category-showcase-title-case);
    color: var(--color-foreground);
    overflow-wrap: anywhere;

    @media screen and (min-width: 990px) {
      font-size: var(--category-showcase-title-size);
    }
  }

  .category-showcase__link {
    display: inline-flex;
    align-items: center;
    gap: 0.9em;
    margin-block-start: var(--margin-sm);
    padding-block: var(--padding-2xs) 0.35em;
    border-block-end: 1px solid var(--category-showcase-underline, var(--color-foreground));
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* The arrow shares the underline color. */
  .category-showcase__arrow {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--category-showcase-underline, currentColor);
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  @media (hover: hover) {
    .category-showcase__item:has(a:hover) .category-showcase__image {
      transform: translateY(-0.375rem);
    }

    .category-showcase__item:has(a:hover) .category-showcase__arrow {
      transform: translateX(0.25rem);
    }

    [dir='rtl'] .category-showcase__item:has(a:hover) .category-showcase__arrow {
      transform: translateX(-0.25rem);
    }
  }

  [dir='rtl'] .category-showcase__arrow {
    scale: -1 1;
  }

  .category-showcase__link:focus-visible {
    outline: var(--focus-outline-width) solid currentColor;
    outline-offset: var(--focus-outline-offset);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-showcase__image,
    .category-showcase__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.category_showcase",
  "class": "category-showcase-section",
  "blocks": [
    {
      "type": "_category-showcase-item"
    }
  ],
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "t:settings.image_height",
      "min": 100,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "t:settings.dividers",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "t:settings.font",
      "default": "instrument_serif_n4"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "t:settings.size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "title_case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "t:settings.underline_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.show_dividers }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.category_showcase",
      "blocks": {
        "category_1": {
          "type": "_category-showcase-item"
        },
        "category_2": {
          "type": "_category-showcase-item"
        },
        "category_3": {
          "type": "_category-showcase-item"
        },
        "category_4": {
          "type": "_category-showcase-item"
        },
        "category_5": {
          "type": "_category-showcase-item"
        }
      },
      "block_order": ["category_1", "category_2", "category_3", "category_4", "category_5"]
    }
  ]
}
{% endschema %}

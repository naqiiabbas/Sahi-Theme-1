{% comment %}
  Section contract.
  "You may also like" row on the product page: products from the current product's collection (excluding the
  product itself), or from a chosen collection, rendered with snippets/category-product-card.liquid.
  The heading link points to that collection.
  @example
  <!-- Add "Related products" to the product template -->
{% endcomment %}

{%- liquid
  assign title_font = section.settings.title_font
  assign source = section.settings.collection
  if section.settings.source == 'product_collection' and product != blank
    # First collection whose handle isn't in the skip list (for example the home page or best sellers).
    assign skip_handles = section.settings.skip_collections | remove: ' ' | split: ','
    for candidate in product.collections
      unless skip_handles contains candidate.handle
        assign source = candidate
        break
      endunless
    endfor
  endif

  assign columns = section.settings.product_count | at_most: 4
  assign image_vw = 100 | divided_by: columns
  assign image_sizes = '(min-width: 990px) ' | append: image_vw | append: 'vw, 50vw'

  assign link_label = ''
  if source != blank and section.settings.link_label != blank
    assign link_label = section.settings.link_label | replace: '[collection]', source.title
  endif

  assign shown = 0
-%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  section_id: section.id
%}

{% comment %} Font families contain quotes, so they live here rather than in the style attribute. {% endcomment %}
{% style %}
  {{ title_font | font_face: font_display: 'swap' }}

  .related-products-{{ section.id }} {
    --related-font: {{ title_font.family }}, {{ title_font.fallback_families }};
    --related-font-weight: {{ title_font.weight }};
    --cpt-title-font: {{ title_font.family }}, {{ title_font.fallback_families }};
    --cpt-title-weight: {{ title_font.weight }};
  }
{% endstyle %}

{%- capture cards -%}
  {%- if source != blank -%}
    {%- for related in source.products -%}
      {%- if related.id == product.id -%}{%- continue -%}{%- endif -%}
      {%- if shown >= section.settings.product_count -%}{%- break -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="related-products__item">
        {% render 'category-product-card',
          product: related,
          section_id: section.id,
          index: forloop.index,
          show_weight: section.settings.show_weight,
          show_rating: section.settings.show_rating,
          image_sizes: image_sizes
        %}
      </li>
    {%- endfor -%}
  {%- elsif request.design_mode -%}
    {%- for i in (1..section.settings.product_count) -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="related-products__item">
        {% render 'category-product-card', section_id: section.id, index: i %}
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if shown > 0 -%}
  <div class="section-background color-custom-{{ section.id }}"></div>
  <div
    class="related-products related-products-{{ section.id }} spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
    style="
      {% render 'spacing-padding', settings: section.settings %}
      --cpt-columns: {{ columns }};
      --cpt-image-ratio: {{ section.settings.image_ratio }};
      --cpt-card-radius: {{ section.settings.card_corner_radius }}px;
      {% if section.settings.accent_color != blank %}--cpt-accent: {{ section.settings.accent_color }}; --cpt-accent-rgb: {{ section.settings.accent_color.rgb }};{% endif %}
      {% if section.settings.card_background != blank %}--cpt-card-bg: {{ section.settings.card_background }};{% endif %}
      {% if section.settings.star_color != blank %}--cpt-star: {{ section.settings.star_color }};{% endif %}
    "
  >
    <div class="related-products__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="related-products__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if link_label != blank -%}
        <a
          href="{{ source.url }}"
          class="related-products__link"
        >
          <span>{{ link_label | escape }}</span>
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 24 16"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M1 8h21M15 2l7 6-7 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <ul class="related-products__grid">
      {{ cards }}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .related-products {
    --cpt-accent-color: var(--cpt-accent, var(--color-foreground));
    --cpt-accent-color-rgb: var(--cpt-accent-rgb, var(--color-foreground-rgb));
    --cpt-active-icon-color: var(--color-background);
    --cpt-card-bg-color: var(--cpt-card-bg, color-mix(in srgb, var(--color-background) 55%, white));
    --cpt-star-color: var(--cpt-star, var(--cpt-accent-color));

    color: var(--color-foreground);
  }

  .related-products__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md) var(--gap-xl);
    margin-block-end: var(--margin-xl);
  }

  /* !important and the extra class beat the global heading font override in theme-styles-variables.liquid. */
  .related-products .related-products__heading {
    font-family: var(--related-font) !important;
  }

  .related-products__heading {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-lg);
    margin: 0;
    font-weight: var(--related-font-weight);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.1;
    color: var(--color-foreground);

    &::after {
      content: '';
      width: 3rem;
      height: 1px;
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
    }
  }

  .related-products__link {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-sm);
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    color: var(--cpt-accent-color);
    text-decoration: none;

    svg {
      width: 1.25rem;
      height: 1rem;
      transition: transform var(--animation-speed) var(--animation-easing);
    }

    &:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;

      svg {
        transform: translateX(0.2rem);
      }
    }
  }

  [dir='rtl'] .related-products__link svg {
    scale: -1 1;
  }

  .related-products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(var(--cpt-columns), minmax(0, 1fr));
      gap: var(--gap-lg);
    }
  }

  .related-products__item {
    display: flex;
    min-width: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .related-products__link svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.related_products",
  "class": "related-products-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "You May Also Like"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:settings.product_eyebrow_source",
      "options": [
        {
          "value": "product_collection",
          "label": "t:options.related_product_collection"
        },
        {
          "value": "collection",
          "label": "t:settings.collection"
        }
      ],
      "default": "product_collection"
    },
    {
      "type": "text",
      "id": "skip_collections",
      "label": "t:settings.skip_collections",
      "info": "t:info.skip_collections",
      "default": "frontpage, best-sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection",
      "info": "t:info.related_collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "t:settings.product_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.label",
      "info": "t:info.related_link_label",
      "default": "View All [collection] Products"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "4 / 3",
          "label": "t:options.landscape"
        },
        {
          "value": "1 / 1",
          "label": "t:options.square"
        },
        {
          "value": "4 / 5",
          "label": "t:options.portrait"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "checkbox",
      "id": "show_weight",
      "label": "t:settings.show_weight",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:settings.show_rating",
      "info": "t:info.show_rating",
      "default": true
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "label": "t:settings.card_corner_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "t:settings.font",
      "default": "instrument_serif_n4"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:settings.card_background",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "t:settings.star_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:names.related_products"
    }
  ]
}
{% endschema %}
